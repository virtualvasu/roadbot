# Required: HuggingFace API Token (free to obtain from huggingface.co)
HF_TOKEN=hf_your_huggingface_token_here

# Optional: OpenAI API Key (for better performance, requires paid plan)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Model Configuration
# MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# Optional: API Configuration
# API_HOST=localhost
# API_PORT=8000
# DEBUG=false

# Optional: Vector Database Configuration
# FAISS_INDEX_PATH=data/processed/faiss_cosine_index.idx
# CHUNK_JSON_PATH=data/processed/TN_traffic_rules_chunks.json

# Optional: Text Processing Configuration
# CHUNK_SIZE=300
# CHUNK_OVERLAP=50
# TOP_K_RESULTS=10

# Optional: Model Generation Parameters
# TEMPERATURE=0.3
# MAX_TOKENS=500